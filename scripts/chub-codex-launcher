#!/usr/bin/env python3
from __future__ import annotations

import argparse
import os
import shlex
import subprocess


def build_codex_command(
    permission_mode: str,
    codex_session: str | None = None,
) -> list[str]:
    codex = ["codex", "--profile", "chub"]
    permission_args = {
        "ask": [
            "-c",
            'default_permissions=":workspace"',
            "-c",
            'approval_policy="on-request"',
            "-c",
            'approvals_reviewer="user"',
        ],
        "auto-review": [
            "-c",
            'default_permissions=":workspace"',
            "-c",
            'approval_policy="on-request"',
            "-c",
            'approvals_reviewer="auto_review"',
        ],
        "read-only": [
            "-c",
            'default_permissions=":read-only"',
            "-c",
            'approval_policy="on-request"',
            "-c",
            'approvals_reviewer="user"',
        ],
        "full-access": [
            "-c",
            'default_permissions=":danger-full-access"',
            "-c",
            'approval_policy="never"',
        ],
    }
    codex.extend(permission_args[permission_mode])
    if codex_session:
        codex.extend(["resume", codex_session])
    return codex


def main() -> int:
    parser = argparse.ArgumentParser()
    parser.add_argument("--name", required=True)
    parser.add_argument("--cwd", required=True)
    parser.add_argument("--chub-session", required=True)
    parser.add_argument("--hook-dir", required=True)
    parser.add_argument("--codex-session")
    parser.add_argument(
        "--permission-mode",
        choices=("ask", "auto-review", "read-only", "full-access"),
        default="ask",
    )
    args = parser.parse_args()

    existing = subprocess.run(
        ["tmux", "has-session", "-t", args.name],
        check=False,
        stdout=subprocess.DEVNULL,
        stderr=subprocess.DEVNULL,
    )
    if existing.returncode == 0:
        os.execvp("tmux", ["tmux", "attach-session", "-t", args.name])

    codex = build_codex_command(args.permission_mode, args.codex_session)
    command = " ".join(
        (
            f"CHUB_PTY_SESSION_ID={shlex.quote(args.chub_session)}",
            f"CHUB_PTY_HOOK_DIR={shlex.quote(args.hook_dir)}",
            shlex.join(codex),
        )
    )
    os.execvp(
        "tmux",
        [
            "tmux",
            "new-session",
            "-s",
            args.name,
            "-c",
            args.cwd,
            command,
        ],
    )


if __name__ == "__main__":
    raise SystemExit(main())
