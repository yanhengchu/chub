#!/usr/bin/env python3
from __future__ import annotations

import json
import os
import re
import stat
import sys
from pathlib import Path


SESSION_ID_PATTERN = re.compile(r"^[A-Za-z0-9_-]{1,80}$")
CODEX_SESSION_ID_PATTERN = re.compile(r"^[A-Za-z0-9][A-Za-z0-9_-]{0,127}$")
LAUNCH_ID_PATTERN = re.compile(r"^[a-f0-9]{32}$")
MAX_REBIND_DEPTH = 8
MAX_REBIND_BYTES = 256


def _read_rebind_target(directory: Path, session_id: str) -> str | None:
    path = directory / f".{session_id}.rebind"
    flags = os.O_RDONLY | getattr(os, "O_CLOEXEC", 0)
    if hasattr(os, "O_NOFOLLOW"):
        flags |= os.O_NOFOLLOW
    try:
        descriptor = os.open(path, flags)
    except (FileNotFoundError, OSError):
        return None
    try:
        metadata = os.fstat(descriptor)
        if (
            not stat.S_ISREG(metadata.st_mode)
            or metadata.st_uid != os.getuid()
            or stat.S_IMODE(metadata.st_mode) & 0o077
            or metadata.st_size > MAX_REBIND_BYTES
        ):
            return None
        with os.fdopen(descriptor, "rb") as alias_file:
            descriptor = -1
            content = alias_file.read(MAX_REBIND_BYTES + 1)
        if len(content) > MAX_REBIND_BYTES:
            return None
    except OSError:
        return None
    finally:
        if descriptor >= 0:
            os.close(descriptor)
    try:
        target = content.decode("ascii").strip()
    except UnicodeDecodeError:
        return None
    return target if SESSION_ID_PATTERN.fullmatch(target) else None


def _resolve_rebound_session(directory: Path, session_id: str) -> str:
    current = session_id
    seen = {current}
    for _ in range(MAX_REBIND_DEPTH):
        target = _read_rebind_target(directory, current)
        if target is None or target in seen:
            return current
        seen.add(target)
        current = target
    return current


def main() -> int:
    chub_session_id = os.environ.get("CHUB_PTY_SESSION_ID", "")
    hook_dir = os.environ.get("CHUB_PTY_HOOK_DIR", "")
    if not SESSION_ID_PATTERN.fullmatch(chub_session_id) or not hook_dir:
        return 0
    directory = Path(hook_dir).expanduser()

    try:
        payload = json.load(sys.stdin)
    except (json.JSONDecodeError, OSError):
        return 0
    codex_session_id = payload.get("session_id")
    if (
        not isinstance(codex_session_id, str)
        or not CODEX_SESSION_ID_PATTERN.fullmatch(codex_session_id)
    ):
        return 0
    event = payload.get("hook_event_name", "SessionStart")
    activity = {
        "SessionStart": "idle",
        "UserPromptSubmit": "working",
        "Stop": "idle",
    }.get(event)
    if activity is None:
        return 0
    chub_session_id = _resolve_rebound_session(directory, chub_session_id)
    launch_id = os.environ.get("CHUB_TERMINAL_LAUNCH_ID")
    if launch_id is not None and not LAUNCH_ID_PATTERN.fullmatch(launch_id):
        return 0
    requested_source = os.environ.get("CHUB_ACTIVITY_SOURCE", "terminal")
    activity_source = (
        "quick"
        if requested_source == "quick"
        else "terminal"
        if activity == "working" and requested_source == "terminal"
        else "none"
    )

    directory.mkdir(parents=True, exist_ok=True)
    target = directory / f"{chub_session_id}.json"
    temporary = directory / f".{chub_session_id}.{os.getpid()}.tmp"
    temporary.write_text(
        json.dumps(
            {
                "chub_session_id": chub_session_id,
                "codex_session_id": codex_session_id,
                "launch_id": launch_id,
                "cwd": payload.get("cwd"),
                "source": payload.get("source"),
                "activity": activity,
                "activity_source": activity_source,
            }
        ),
        encoding="utf-8",
    )
    os.chmod(temporary, 0o600)
    temporary.replace(target)
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
