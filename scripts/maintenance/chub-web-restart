#!/usr/bin/env bash

set -euo pipefail

SCRIPT_DIR="$(cd -P "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
PROJECT_ROOT="$(cd "$SCRIPT_DIR/../.." && pwd)"

if [[ -n "${CHUB_QUICK_TASK_ID:-}" ]]; then
    REQUEST_DIR="${CHUB_QUICK_RESTART_DIR:-}"
    TASK_ID="${CHUB_QUICK_TASK_ID:-}"
    if [[ -z "$REQUEST_DIR" || "$REQUEST_DIR" != /* || ! -d "$REQUEST_DIR" || -L "$REQUEST_DIR" ]]; then
        echo "chub-web-restart: deferred restart directory is unavailable" >&2
        exit 1
    fi
    case "$TASK_ID" in
        ""|*[!A-Za-z0-9_-]*)
            echo "chub-web-restart: deferred restart task id is invalid" >&2
            exit 1
            ;;
    esac
    REQUEST_FILE="$REQUEST_DIR/$TASK_ID.request"
    if [[ -L "$REQUEST_FILE" || ( -e "$REQUEST_FILE" && ! -f "$REQUEST_FILE" ) ]]; then
        echo "chub-web-restart: deferred restart request is invalid" >&2
        exit 1
    fi
    if [[ ! -e "$REQUEST_FILE" ]]; then
        umask 077
        (set -o noclobber; : > "$REQUEST_FILE") 2>/dev/null || {
            echo "chub-web-restart: unable to register deferred restart" >&2
            exit 1
        }
    fi
    if [[ -L "$REQUEST_FILE" || ! -f "$REQUEST_FILE" ]]; then
        echo "chub-web-restart: deferred restart request is invalid" >&2
        exit 1
    fi
    chmod 600 "$REQUEST_FILE"
    echo "Chub restart registered after this quick interaction finishes."
    echo "Finish the task normally; Chub will append the accurate restart status to the final response."
    exit 0
fi

exec "$PROJECT_ROOT/scripts/platform/service-management.sh" web-restart-async
