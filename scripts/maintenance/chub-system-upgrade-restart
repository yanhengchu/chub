#!/usr/bin/env bash

set -euo pipefail

SCRIPT_DIR="$(cd -P "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
PROJECT_ROOT="$(cd "$SCRIPT_DIR/../.." && pwd)"
PYTHON_BIN="$PROJECT_ROOT/.venv/bin/python"
PLATFORM="${CHUB_TEST_PLATFORM:-$(uname -s)}"
MODE="${2:-restart}"

if [[ "${1:-}" == "--pending" ]]; then
    OPERATION_ID="$("$PYTHON_BIN" -m app.system_upgrade_cli pending-operation)"
    MODE="restart"
else
    OPERATION_ID="${1:-}"
fi

case "$OPERATION_ID" in
    ""|*[!a-f0-9]*)
        echo "chub-system-upgrade-restart: invalid operation id" >&2
        exit 2
        ;;
esac
if [[ "${#OPERATION_ID}" -ne 32 ]]; then
    echo "chub-system-upgrade-restart: invalid operation id" >&2
    exit 2
fi
if [[ "$MODE" != "restart" && "$MODE" != "--recover-worker" ]]; then
    echo "chub-system-upgrade-restart: invalid mode" >&2
    exit 2
fi
if [[ -n "${CHUB_QUICK_TASK_ID:-}" ]]; then
    echo "chub-system-upgrade-restart: cannot run from Quick Worker" >&2
    exit 1
fi

prepare_restart() {
    (
        cd "$PROJECT_ROOT"
        "$PYTHON_BIN" -m app.system_upgrade_cli "$OPERATION_ID"
    )
}

wait_for_launch_confirmation() {
    (
        cd "$PROJECT_ROOT"
        "$PYTHON_BIN" -m app.system_upgrade_cli \
            wait-for-launch "$OPERATION_ID"
    )
}

record_component() {
    local component="$1"
    local status="$2"
    local message="$3"
    if (
        cd "$PROJECT_ROOT"
        "$PYTHON_BIN" -m app.system_upgrade_cli \
            record-component "$OPERATION_ID" "$component" "$status" "$message"
    ) >/dev/null 2>&1; then
        echo "chub-system-upgrade-restart: component=$component status=$status operation_id=$OPERATION_ID"
    fi
}

run_platform_action() {
    "$PROJECT_ROOT/scripts/platform/service-management.sh" "$@"
}

confirm_recovered_worker() {
    # Linux relies on the new Web instance to perform the existing final
    # health reconciliation.  macOS must confirm here because bootstrap is
    # also responsible for creating the Worker socket after the old job was
    # explicitly unloaded.
    [[ "$PLATFORM" == "Darwin" ]] || return 0
    wait_for_worker_ready
}

echo "chub-system-upgrade-restart: scope=chub_ai_runtime,chub_web,quick_worker excludes=openclaw,debug_chrome,python_dependencies operation_id=$OPERATION_ID"
echo "chub-system-upgrade-restart: waiting for launch confirmation operation_id=$OPERATION_ID"
if [[ "$MODE" == "restart" ]]; then
    wait_for_launch_confirmation
    echo "chub-system-upgrade-restart: launch confirmed operation_id=$OPERATION_ID"
fi

recover_worker() {
    run_platform_action worker-restart
}

wait_for_worker_ready() {
    local payload
    for _attempt in $(seq 1 60); do
        if payload="$(
            cd "$PROJECT_ROOT"
            "$PYTHON_BIN" -m app.quick_worker health 2>/dev/null
        )" && "$PYTHON_BIN" -c '
import json
import sys

from app.quick_worker import PROTOCOL_VERSION

payload = json.loads(sys.stdin.read())
data = payload.get("data") if payload.get("success") is True else None
if not isinstance(data, dict):
    raise SystemExit(1)
if data.get("status") != "ready":
    raise SystemExit(1)
if any(data.get(name) != 0 for name in ("active_tasks", "queued_tasks", "uncertain_tasks", "corrupt_tasks")):
    raise SystemExit(1)
if data.get("protocol_version") != PROTOCOL_VERSION:
    raise SystemExit(1)
' <<<"$payload"; then
            return 0
        fi
        sleep 0.5
    done
    echo "chub-system-upgrade-restart: Quick Worker did not recover ready state" >&2
    return 1
}

recover_on_failure() {
    local exit_code="$1"
    [[ "$MODE" == "restart" && "$exit_code" -ne 0 ]] || return 0
    set +e
    (
        cd "$PROJECT_ROOT"
        "$PYTHON_BIN" -m app.system_upgrade_cli \
            fail-operation "$OPERATION_ID" \
            "服务切换脚本失败，退出码=$exit_code"
    ) >/dev/null 2>&1 || true
    run_platform_action core-service-definitions >/dev/null 2>&1
    recover_worker >/dev/null 2>&1
    "$PROJECT_ROOT/scripts/maintenance/chub-web-restart"
}

trap 'recover_on_failure "$?"' EXIT

if [[ "$MODE" == "--recover-worker" ]]; then
    recover_worker
    wait_for_worker_ready
    exit 0
fi

case "$PLATFORM" in
    Darwin|Linux)
        run_platform_action web-stop >/dev/null 2>&1 || true
        run_platform_action worker-stop
        if ! prepare_restart; then
            recover_worker >/dev/null 2>&1 || true
            exit 1
        fi
        if ! run_platform_action core-service-definitions; then
            echo "chub-system-upgrade-restart: core service definitions could not be repaired" >&2
            exit 1
        fi
        recover_worker
        confirm_recovered_worker
        exec "$PROJECT_ROOT/scripts/maintenance/chub-web-restart"
        ;;
    *)
        echo "chub-system-upgrade-restart: unsupported platform: $PLATFORM" >&2
        exit 1
        ;;
esac
